rules_version = '2';

// Who may read and write what.
//
//   users/{uid}/songs/{songId}   a person's own songs
//     - Only the owner can list, create, change or delete their songs.
//     - A song can be read by anyone holding its link, but only while its owner has
//       switched sharing on (shared == true). Nobody else can list a person's songs,
//       so a private song's id cannot be discovered.
//     - An admin can see every song and switch a shared one off (shared: false,
//       blocked: true). The owner cannot share a blocked song again.
//     - A copy can say where it came from (from: title, credit, link or page of the
//       original), never whose account it was in.
//     - The owner can offer a shared song to the community shelf (featurable: true).
//   users/{uid}/snapshots/{id}   a person's channel snapshots (a few bars of one channel's sound)
//     - Only the owner can read, list, write or delete them; nobody else, admins included.
//     - The record says how long the recording is and how many chunks/{n} it is stored in;
//       each chunk is raw bytes under a megabyte, at most eight of them.
//   shares/{uuid}                what a share link points at
//     - A link is a UUID. Anyone holding it can read whose song it names, nothing more;
//       nobody can list them. Only the owner creates one, for themselves.
//   beats/{id}                   the site's beats
//     - Anyone can read the featured beat. Signed-in people can also read a beat the
//       admin has opened to members (members == true). Every other beat is the admin's
//       own. Only an admin can write.
//   catalog/public               titles and descriptions of the beats, without their code
//     - Anyone can read it. Only an admin can write it.
//   community/{shareId}          the community shelf: shared songs the site features
//     - Anyone can read an entry, and list at most 48 at once.
//     - Only an admin can write one, and only for a song its owner has offered: shared by
//       that link, featurable, not blocked. An entry holds what the link already shows
//       (title, credit, sharer, tempo, track count, header notes, remix credit), never
//       the code, an account or the song's id.
//     - The admin, or the owner named by the link's record, can remove one. So an entry
//       is removed before its link's record, everywhere.
//   Admins
//     - An admin is an account with a marker document, admins/{uid}, created in the
//       Firebase console (it can be empty). Nobody can write that collection from the
//       site, so nothing in a browser can grant the role.
//     - roles/admin is a question, not a document: the site asks for it to learn whether
//       the person signed in is an admin, and only an admin gets an answer.
//   Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // An admin is an account with a marker document in admins/. The marker costs a read
    // of its own, so isAdmin() comes last in every condition that uses it.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Where a copy came from: what was already public about the original.
    function validFrom(from) {
      return from is map
        && from.keys().hasOnly(['title', 'by', 'ownerName', 'shareId', 'beat'])
        && from.keys().hasAll(['title'])
        && from.title is string && from.title.size() <= 200
        && (!('by' in from) || (from.by is string && from.by.size() <= 200))
        && (!('ownerName' in from) || (from.ownerName is string && from.ownerName.size() <= 200))
        && (!('shareId' in from) || (from.shareId is string && from.shareId.size() <= 64))
        && (!('beat' in from) || (from.beat is string && from.beat.size() <= 120));
    }

    // What a song document may contain, and how big it may be.
    function validSong(song) {
      return song.keys().hasOnly(['code', 'title', 'createdAt', 'updatedAt', 'shared', 'mixer', 'ownerName', 'blocked', 'shareId', 'from', 'featurable'])
        && song.keys().hasAll(['code', 'title', 'createdAt', 'updatedAt', 'shared'])
        && song.code is string && song.code.size() <= 200000
        && song.title is string && song.title.size() <= 200
        && song.createdAt is number
        && song.updatedAt is number
        && song.shared is bool
        && (!('mixer' in song) || (song.mixer is list && song.mixer.size() <= 64))
        && (!('ownerName' in song) || (song.ownerName is string && song.ownerName.size() <= 200))
        && (!('blocked' in song) || song.blocked is bool)
        && (!('shareId' in song) || (song.shareId is string && song.shareId.size() <= 64))
        && (!('from' in song) || validFrom(song.from))
        && (!('featurable' in song) || song.featurable is bool);
    }
    function blocked(song) {
      return song.get('blocked', false);
    }

    match /users/{uid}/songs/{songId} {
      allow get: if signedInAs(uid) || resource.data.shared == true || isAdmin();
      allow list: if signedInAs(uid);
      allow create: if signedInAs(uid) && validSong(request.resource.data) && !blocked(request.resource.data);
      // the owner cannot lift a block, or share a song while it is blocked
      allow update: if (signedInAs(uid)
          && validSong(request.resource.data)
          && blocked(request.resource.data) == blocked(resource.data)
          && !(blocked(request.resource.data) && request.resource.data.shared))
        // an admin can do exactly one thing to someone's song: switch its sharing off
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shared', 'blocked'])
          && request.resource.data.shared == false
          && request.resource.data.blocked == true
          && isAdmin());
      allow delete: if signedInAs(uid);
    }

    // A channel snapshot's record (js/snapshots-core.js cleanSnapshot), and one piece of its WAV.
    function validSnapshot(snap, id) {
      return snap.keys().hasOnly(['id', 'name', 'track', 'songTitle', 'bars', 'cps', 'sampleRate', 'frames', 'slot', 'pinned', 'createdAt', 'updatedAt', 'chunks'])
        && snap.keys().hasAll(['id', 'name', 'bars', 'cps', 'sampleRate', 'frames', 'createdAt', 'updatedAt', 'chunks'])
        && snap.id == id && id.matches('^[0-9a-f]{8,40}$')
        && snap.name is string && snap.name.size() <= 60
        && (!('track' in snap) || (snap.track is string && snap.track.size() <= 60))
        && (!('songTitle' in snap) || (snap.songTitle is string && snap.songTitle.size() <= 200))
        && snap.bars in [1, 2, 4, 8]
        && snap.cps is number && snap.cps > 0 && snap.cps <= 10
        && snap.sampleRate is int && snap.sampleRate >= 8000 && snap.sampleRate <= 192000
        && snap.frames is int && snap.frames > 0 && snap.frames <= snap.sampleRate * 31
        && (!('slot' in snap) || snap.slot == null || (snap.slot is int && snap.slot >= 0 && snap.slot < 8))
        && (!('pinned' in snap) || snap.pinned == null || snap.pinned in ['A', 'B'])
        && snap.createdAt is number
        && snap.updatedAt is number
        && snap.chunks is int && snap.chunks >= 1 && snap.chunks <= 8;
    }

    match /users/{uid}/snapshots/{snapId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validSnapshot(request.resource.data, snapId);

      match /chunks/{n} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && n in ['0', '1', '2', '3', '4', '5', '6', '7']
          && request.resource.data.keys().hasOnly(['n', 'data'])
          && request.resource.data.n is int
          && string(request.resource.data.n) == n
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 900000;
      }
    }

    // What a share link points at. The link is a UUID, so it cannot be guessed, and these
    // cannot be listed. Reading one gives away only whose song it is and which; the song
    // itself is still only readable while its owner has sharing on.
    match /shares/{shareId} {
      allow get: if true;
      allow create, update: if signedIn()
        && shareId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && request.resource.data.keys().hasOnly(['owner', 'song', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.song is string && request.resource.data.song.size() <= 64
        && (resource == null || resource.data.owner == request.auth.uid);
      allow delete: if (signedIn() && resource.data.owner == request.auth.uid) || isAdmin();
    }

    // every person's songs at once: the admin's list of what is shared
    match /{path=**}/songs/{songId} {
      allow list: if isAdmin();
    }

    function validBeat(beat) {
      return beat.keys().hasOnly(['code', 'title', 'by', 'slug', 'order', 'featured', 'members', 'hidden', 'song', 'createdAt', 'updatedAt'])
        && beat.keys().hasAll(['code', 'title', 'slug', 'order', 'featured', 'hidden', 'createdAt', 'updatedAt'])
        && beat.code is string && beat.code.size() <= 200000
        && beat.title is string && beat.title.size() <= 200
        && beat.slug is string && beat.slug.matches('^[a-z0-9-]{1,120}$')
        && beat.order is number
        && beat.featured is bool
        && beat.hidden is bool
        && beat.createdAt is number
        && beat.updatedAt is number
        && (!('by' in beat) || (beat.by is string && beat.by.size() <= 200))
        && (!('members' in beat) || beat.members is bool)
        && (!('song' in beat) || (beat.song is string && beat.song.size() <= 64));
    }

    match /beats/{beatId} {
      allow get, list: if resource.data.featured == true
        || (signedIn() && resource.data.get('members', false) == true)
        || isAdmin();
      allow create, update: if validBeat(request.resource.data) && isAdmin();
      allow delete: if isAdmin();
    }

    match /catalog/{name} {
      allow get: if true;
      allow create, update: if name == 'public'
        && request.resource.data.keys().hasOnly(['beats', 'updatedAt'])
        && request.resource.data.beats is list && request.resource.data.beats.size() <= 500
        && isAdmin();
    }

    // A shelf entry: what the song's link already shows, nothing more.
    function validFeature(entry) {
      return entry.keys().hasOnly(['title', 'by', 'ownerName', 'bpm', 'trackCount', 'blurb', 'from', 'featuredAt'])
        && entry.keys().hasAll(['title', 'featuredAt'])
        && entry.title is string && entry.title.size() <= 200
        && (!('by' in entry) || (entry.by is string && entry.by.size() <= 200))
        && (!('ownerName' in entry) || (entry.ownerName is string && entry.ownerName.size() <= 200))
        && (!('bpm' in entry) || (entry.bpm is number && entry.bpm > 0 && entry.bpm < 10000))
        && (!('trackCount' in entry) || (entry.trackCount is int && entry.trackCount > 0 && entry.trackCount <= 1000))
        && (!('blurb' in entry) || (entry.blurb is string && entry.blurb.size() <= 300))
        && (!('from' in entry) || validCredit(entry.from))
        && entry.featuredAt is number;
    }
    function validCredit(from) {
      return from is map
        && from.keys().hasOnly(['title', 'by', 'ownerName'])
        && from.keys().hasAll(['title'])
        && from.title is string && from.title.size() <= 200
        && (!('by' in from) || (from.by is string && from.by.size() <= 200))
        && (!('ownerName' in from) || (from.ownerName is string && from.ownerName.size() <= 200));
    }
    // The song a link names is shared by that link and offered by its owner. Two reads.
    function offered(shareId) {
      let share = get(/databases/$(database)/documents/shares/$(shareId)).data;
      let song = get(/databases/$(database)/documents/users/$(share.owner)/songs/$(share.song)).data;
      return song.shared == true
        && song.get('featurable', false) == true
        && !blocked(song)
        && song.get('shareId', shareId) == shareId;
    }

    match /community/{shareId} {
      allow get: if true;
      allow list: if request.query.limit <= 48;
      allow create, update: if validFeature(request.resource.data) && isAdmin() && offered(shareId);
      allow delete: if (signedIn() && get(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid)
        || isAdmin();
    }

    match /admins/{uid} {
      allow get: if signedInAs(uid);
    }

    match /roles/admin {
      allow get: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
