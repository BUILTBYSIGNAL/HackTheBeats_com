{
  "name": "hacking-the-beats",
  "version": "0.9.1",
  "description": "A live-coded music art piece built on Strudel: read-only animated code, inline visuals and a DJ deck.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "version": "node tools/set-version.mjs && git add js/version.js sw.js",
    "build:vendor": "node tools/build-strudel.mjs",
    "build:firebase": "node tools/build-firebase.mjs",
    "build:functions": "node tools/build-functions.mjs",
    "beats": "node tools/build-manifest.mjs",
    "samples": "node tools/vendor-samples.mjs",
    "build": "node tools/build-manifest.mjs && node tools/build-site.mjs",
    "deploy": "node tools/build-manifest.mjs && node tools/build-site.mjs --strict && node tools/build-functions.mjs && node tools/deploy.mjs",
    "check:public": "node tools/check-public.mjs",
    "deploy:first": "node tools/build-manifest.mjs && node tools/build-site.mjs --strict --seed && node tools/build-functions.mjs && node tools/deploy.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:browsers": "node tests/browser/smoke.mjs",
    "test:songs": "node tests/browser/songs.mjs",
    "test:accounts": "node tests/browser/accounts.mjs"
  },
  "devDependencies": {
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.1",
    "@codemirror/view": "^6.36.2",
    "@lezer/highlight": "^1.2.1",
    "@strudel/codemirror": "1.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "acorn": "^8.14.0",
    "esbuild": "^0.25.0",
    "firebase": "^12.19.0",
    "playwright": "^1.63.0",
    "superdough": "1.3.0"
  }
}
